@{
    ViewData["Title"] = "Home Page";
    var databases = ViewBag.Databases as IEnumerable<dynamic>;
   
    bool isAdmin = ViewBag.IsAdmin ?? false;
    int activeCount = ViewBag.ActiveCount ?? 0;
}
<div class="container mt-4">
    <h1 class="text-center mb-4">Welcome</h1>

    <div id="database-section" class="mb-3">
        <label for="database-dropdown" class="form-label">Select Database:</label>
        <select id="database-dropdown" class="form-select">
            <option value="">-- Select --</option>
            @if (databases != null)
            {
                foreach (var db in databases)
                {
                    <option value="@db.DBID">@db.DBName</option>
                    // Access as properties; if dictionary, use db["DBID"] etc.
                }
            }
        </select>
    </div>
    <div id="search-section" class="mb-3" style="display:none;">
        <label for="search-input" class="form-label">Search Term:</label>
        <input type="text" id="search-input" class="form-control" placeholder="Enter value to search..." />
        <button id="search-button" class="btn btn-primary mt-2">Search</button>
    </div>

<div id="search-results" class="mt-4"></div>

    <div id="table-section" class="mb-3" style="display:none;">
        <label for="table-dropdown" class="form-label">Select Table:</label>
        <select id="table-dropdown" class="form-select">
            <option value="">-- Select --</option>
        </select>
    </div>

    @if (isAdmin)
    {
        <div class="mt-4">
        
            <a class="btn btn-primary" href="@Url.Action("ManageDatabases", "Home")">Manage Databases (<strong>@activeCount</strong>)

        </a>
        </div>
        <div class="mt-3">
            <a class="btn btn-secondary" href="@Url.Action("UserRights", "UserRights")">
                Manage User Rights
            </a>
        </div>
    }
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(function () {
            $("#database-dropdown").change(function () {
                var dbid = $(this).val();
                if (dbid) {
                    $.post('@Url.Action("GetTables", "Home")', { dbid: dbid }, function (tables) {
                        var $tableDropdown = $("#table-dropdown");
                        $tableDropdown.empty().append('<option value="">-- Select --</option>');
                        $.each(tables, function (i, table) {
                            $tableDropdown.append('<option value="' + table.tableName + '">' + table.tableName + '</option>');
                        });
                        $("#database-section").hide();
                        $("#table-section").show();
                    }).fail(function () {
                        alert("Failed to load tables.");
                    });
                } else {
                    $("#table-section").hide();
                    $("#database-section").show();
                }
            });

            $("#table-dropdown").change(function () {
                var tableName = $(this).val();
                var dbid = $("#database-dropdown").val();
                if (tableName) {
                    var url = '@Url.Action("ViewTable", "Data")';
                    window.location.href = url + "?dbid=" + encodeURIComponent(dbid) + "&tableName=" + encodeURIComponent(tableName);
                }
            });
            $("#database-dropdown").change(function () {
               
                var tableName = $(this).val();
                var dbid = $("#database-dropdown").val();
                if (tableName) {
                    $("#search-section").show();
                } else {
                    $("#search-section").hide();
                }
            });

            $("#search-button").click(function () {
                var dbid = $("#database-dropdown").val();
                var searchValue = $("#search-input").val();
                if (!searchValue) {
                    alert("Please enter a value to search.");
                    return;
                }

                $.post('@Url.Action("SearchDatabase", "Home")', {
                    dbId: dbid,
                    search: searchValue
                }, function (results) {
                    var $results = $("#search-results");
                    $results.empty();
                    if (results.length === 0) {
                        $results.html("<div class='alert alert-info'>No matches found.</div>");
                        return;
                    }

                    var html = '<table class="table table-bordered"><thead><tr><th>Table</th><th>Column</th><th>Matched Value</th></tr></thead><tbody>';
                    $.each(results, function (i, row) {
                        html += '<tr><td>' + row.tableName + '</td><td>' + row.columnName + '</td><td>' + row.matchedValue + '</td></tr>';
                    });
                    html += '</tbody></table>';
                    $results.html(html);
                }).fail(function () {
                    alert("Error occurred during search.");
                });
            });

        });
    </script>
}
