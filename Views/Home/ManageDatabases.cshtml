@model List<MULTI___DATABASE_PORTAL.Controllers.HomeController.DatabaseInfo>
@{
    ViewData["Title"] = "Manage Databases";
}

<div class="container mt-4">
    <h1>Manage Databases</h1>

    <h3>Add New Database</h3>
    <form asp-controller="Home" asp-action="AddDatabase" method="post" class="mt-3">
        <div class="mb-3">
            <label for="DBName" class="form-label">Database Name</label>
            <input type="text" id="DBName" name="DBName" class="form-control" required />
        </div>
        <div class="mb-3">
            <label for="DBConnString" class="form-label">Connection String</label>
            <input type="text" id="DBConnString" name="DBConnString" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-primary">Add Database</button>
    </form>

    <p>Total Active Databases: @Model.Count(d => d.IsActive)</p>
    <h3>Available Database</h3>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Database Name</th>
            <th>Connection String</th>
            <th>Active</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var db in Model)
        {
            <tr>
                <td>@db.DBID</td>
                <td>@db.DBName</td>
                <td>@db.ConnectionString</td>
                <td>@(db.IsActive ? "Yes" : "No")</td>
                <td>
                    @if (db.IsActive)
                    {
                        <form method="post" asp-action="DeactivateDatabase" asp-controller="Home" onsubmit="return confirm('Are you sure you want to deactivate this database?');" style="display:inline;">
                            <input type="hidden" name="dbId" value="@db.DBID" />
                            <button type="submit" class="btn btn-warning btn-sm">Deactivate</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-action="ActivateDatabase" asp-controller="Home" onsubmit="return confirm('Are you sure you want to activate this database?');" style="display:inline;">
                            <input type="hidden" name="dbId" value="@db.DBID" />
                            <button type="submit" class="btn btn-success btn-sm">Activate</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>





</div>
