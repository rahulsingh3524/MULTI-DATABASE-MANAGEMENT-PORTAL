@model List<MULTI___DATABASE_MANAGEMENT_PORTAL.Models.DatabaseInfo>
@{
    ViewData["Title"] = "Manage Databases";
}

<div class="content-wrapper p-3">
    <section class="content-header">
        <div class="container-fluid">
            <h1><i class="fas fa-database"></i> Manage Databases</h1>
        </div>
    </section>

    <section class="content">
        <div class="row">
            <!-- Add New Database Card -->
            <div class="col-md-5">
                <div class="card card-primary">
                    <div class="card-header bg-primary">
                        <h3 class="card-title"><i class="fas fa-plus-circle"></i> Add New Database</h3>
                    </div>
                    <form asp-controller="Home" asp-action="AddDatabase" method="post">
                        <div class="card-body">
                            <div class="form-group mb-3">
                                <label for="DBName">Database Name</label>
                                <input type="text" id="DBName" name="DBName" class="form-control" required placeholder="e.g., TicketingSystemDB" />
                            </div>
                            <div class="form-group mb-0">
                                <label for="DBConnString">Connection String</label>
                                <input type="text" id="DBConnString" name="DBConnString" class="form-control" required placeholder="Set valid SQL connection string" />
                            </div>
                        </div>
                        <div class="card-footer bg-white">
                            <button type="submit" class="btn btn-primary"><i class="fas fa-database"></i> Add Database</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Database Table Card -->
            <div class="col-md-7">
                <div class="card card-outline card-info">
                    <div class="card-header bg-info">
                        <h3 class="card-title"><i class="fas fa-list"></i> Available Databases</h3>
                    </div>
                    <div class="card-body p-2">
                        <div class="alert alert-secondary py-1 ml-1 mb-2">
                            <strong>Total Active Databases:</strong>  @Model.Count(d => d.IsActive)
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover table-striped table-bordered">
                                <thead class="thead-dark">
                                    <tr>
                                        <th>ID</th>
                                        <th>Name</th>
                                        <th>Connection String</th>
                                        <th>Active</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var db in Model)
                                    {
                                        <tr>
                                            <td>@db.DBID</td>
                                            <td><i class="fas fa-server mr-1 text-blue"></i>@db.DBName</td>
                                            <td style="font-size: 90%; word-break: break-all;">@db.ConnectionString</td>
                                            <td>
                                                @if (db.IsActive)
                                                {
                                                    <span class="badge badge-success">Yes</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-danger">No</span>
                                                }
                                            </td>
                                            <td>
                                                @if (db.IsActive)
                                                {
                                                    <form method="post" asp-action="DeactivateDatabase" asp-controller="Home"
                                                          onsubmit="return confirm('Deactivate this database?');" style="display:inline;">
                                                        <input type="hidden" name="dbId" value="@db.DBID" />
                                                        <button type="submit" class="btn btn-warning btn-sm">
                                                            <i class="fas fa-ban"></i> Deactivate
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <form method="post" asp-action="ActivateDatabase" asp-controller="Home"
                                                          onsubmit="return confirm('Activate this database?');" style="display:inline;">
                                                        <input type="hidden" name="dbId" value="@db.DBID" />
                                                        <button type="submit" class="btn btn-success btn-sm">
                                                            <i class="fas fa-check-circle"></i> Activate
                                                        </button>
                                                    </form>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>
</div>
