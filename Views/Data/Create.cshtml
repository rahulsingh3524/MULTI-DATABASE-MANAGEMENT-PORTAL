@model List<string>

@{
    ViewData["Title"] = "Create Record";
}

<h2>Add New Record - @ViewBag.TableName</h2>

<form asp-action="Create" method="post">
    <input type="hidden" name="tableName" value="@ViewBag.TableName" />
    @foreach (var column in Model)
    {
        <div class="mb-2">
            <label>@column</label>
            <input type="text" name="@column" class="form-control" />
        </div>
    }
    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="ViewTable" asp-route-tableName="@ViewBag.TableName" class="btn btn-secondary">Cancel</a>
</form>
